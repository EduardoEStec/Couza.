# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# cloudflare / opennext (gerado pelo build)
/.open-next/
/.wrangler/
.dev.vars

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design: as fontes do canvas (.dc.html + canvas.json) ficam versionadas;
# o arquivo publicado é gerado a partir delas e pesa ~2,6 MB.
/design/courte-site-e-portal.html

# o modelo vai versionado; os valores reais nao
!.env.example
