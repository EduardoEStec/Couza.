{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "couza",

  /**
   * A conta PESSOAL, e nao a chamada "couza" — de proposito.
   *
   * Uma zona vive numa conta so na Cloudflare, e couza.com.br esta nesta
   * aqui. Deixar o Worker numa conta e o dominio noutra nao funciona: o
   * deploy recusa com "Could not find zone".
   *
   * A alternativa seria mudar a zona de conta, mas mudar de conta apaga os
   * registros de DNS — inclusive os que verificam envio.couza.com.br na
   * Resend. Ate recria-los e reverificar, e-mail nenhum sairia.
   *
   * Compartilhar a conta com outros Workers custa o seguinte, conferido em
   * 15/09/2026: a cota de 100 mil requisicoes/dia do plano free e por
   * CONTA, e o teto de 5 Cron Triggers tambem. Aqui ja havia 2 crons, o
   * nosso e o terceiro. E o grosso do trafego do site sai por assets
   * estaticos, que nao invocam o Worker e nao contam para cota nenhuma.
   */
  "account_id": "dd0e28e28c430023c4bd6dea71852100",

  // Aponta para o worker CUSTOMIZADO, não para o gerado. O gerado só sabe
  // responder a requisições HTTP; o nosso acrescenta o handler `scheduled`,
  // que é como o Cron Trigger chega — Cron Trigger não é uma rota.
  "main": "custom-worker.ts",

  "compatibility_date": "2025-09-01",
  // nodejs_compat: o adaptador precisa das APIs de Node.
  // global_fetch_strictly_public: faz fetch() para o próprio domínio sair
  // pela internet pública em vez de ser interceptado internamente.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // 12:00 UTC = 09:00 em São Paulo (UTC−3 fixo, sem horário de verão desde
  // 2019). O Cron Trigger da Cloudflare só entende UTC.
  "triggers": {
    "crons": ["0 12 * * *"]
  },

  // Nao sao segredo: podem ficar no repositorio. Tudo que e sigiloso entra
  // como secret do Worker (`npx wrangler secret put`), nunca aqui.
  "vars": {
    // SANDBOX ate o teste ponta a ponta terminar. A troca para
    // "producao" e o ULTIMO passo do deploy, e so com o aval do Guilherme
    // na hora — exigencia do ETAPAS.md.
    "ASAAS_AMBIENTE": "sandbox",
    "URL_BASE": "https://couza.com.br",
    "SMS_ATIVO": "false"
  },

  // custom_domain cria o registro de DNS sozinho, na zona couza.com.br.
  "routes": [
    { "pattern": "couza.com.br", "custom_domain": true }
  ],

  /**
   * Logs do Worker, LIGADOS de propósito e declarados aqui em vez de
   * herdados do padrão.
   *
   * Eles guardam a saída de console.* e metadados de invocação — não o
   * corpo da requisição. É por isso que manter ligado não conflita com a
   * regra de nunca registrar dado de cartão: o dado do cartão viaja no
   * corpo, que não entra aqui. Quem protege isso é a disciplina em
   * src/app/portal/pagamento/[id]/acoes.ts, não este botão.
   *
   * Desligar cegaria a produção sem somar nenhuma segurança.
   */
  "observability": {
    "enabled": true
  }
}
