# ===================================================================
#  MODELO. Copie para .env.local e preencha la.
#  O .env.local e ignorado pelo git e nunca vai para o repositorio.
#
#  Isto vale para DESENVOLVIMENTO. Em producao (Cloudflare Workers)
#  estes valores entram como secret do Worker, nao como arquivo:
#      npx wrangler secret put DATABASE_URL
# ===================================================================

# --- Banco (Neon) --------------------------------------------------
# As duas apontam para o MESMO banco, mesma senha. A unica diferenca
# e o "-pooler" no hostname.
#
# POOLED: usada pelo app. Modo transacao, uma conexao por requisicao.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/courte?sslmode=require"
#
# DIRETA: usada SO pelas migracoes do Drizzle Kit. Migracao precisa de
# estado de sessao (lock, DDL longo), que o pooled nao mantem.
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/courte?sslmode=require"

# --- Ainda nao usados ----------------------------------------------
# Descomente quando a fase correspondente chegar.
#
# Fase 2 — e-mail transacional
# RESEND_API_KEY=""
# EMAIL_REMETENTE="courte <nao-responda@envio.courte.com.br>"  # subdominio, nao a raiz
#
# Admin (so voce). Sem tabela no banco: e uma pessoa so.
# Gere os tres com:  npm run admin:credenciais
# A senha aparece uma vez na tela; aqui fica so o hash bcrypt.
# Trocar ADMIN_SESSAO_SEGREDO derruba toda sessao de admin na hora.
ADMIN_EMAIL=""
ADMIN_SENHA_HASH=""
ADMIN_SESSAO_SEGREDO=""
# Opcional: a senha em claro, SO para o npm run teste:admin conferir o login.
# ADMIN_SENHA_TESTE=""
#
# Fase 4 — pagamentos
# ASAAS_API_KEY=""
# ASAAS_AMBIENTE="sandbox"        # sandbox | producao
# ASAAS_WEBHOOK_TOKEN=""

# Endereco base do site, usado para montar o link que vai no e-mail.
# Em producao: https://courte.com.br
URL_BASE="http://localhost:3000"
